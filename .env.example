# Copy the values you need into .env.local (kept out of git).

# Catalogue API (`npm run server`)
# Local Postgres from `npm run db:up`; a hosted database usually needs ?sslmode=require on the end.
DATABASE_URL=postgres://dalga:dalga@localhost:5432/dalga
# Password for /admin.
ADMIN_PASSWORD=
# Random string of at least 32 characters that signs admin logins: `openssl rand -base64 48`
SESSION_SECRET=
# Optional: where uploaded product photos are saved (default server/uploads) and the API port (default 3001).
# UPLOAD_DIR=
# PORT=3001
